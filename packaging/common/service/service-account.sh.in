# Shared service-account creation for the Linux packaging backends.
#
# This snippet is inlined verbatim into the Debian postinst and the RPM %pre
# scriptlet by engineering/tools/render_package_metadata.py, so both backends
# create the same account with the same properties instead of drifting apart.
# It must stay POSIX sh, idempotent, and must never modify an existing account:
# an operator who already provisioned @SERVICE_USER@ keeps their definition.
if ! getent group '@SERVICE_GROUP@' >/dev/null 2>&1; then
    groupadd --system '@SERVICE_GROUP@'
fi
if ! getent passwd '@SERVICE_USER@' >/dev/null 2>&1; then
    useradd --system --gid '@SERVICE_GROUP@' --home-dir '@STATEDIR@' \
        --no-create-home --shell /usr/sbin/nologin \
        --comment 'GlifiStore daemon' '@SERVICE_USER@'
fi
