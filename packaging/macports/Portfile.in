# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

# Rendered by engineering/tools/render_macos_packaging.py from
# packaging/macports/Portfile.in. VERSION is the single source of truth and the
# release context supplies the distfile identity, so version, master sites and
# checksums are never written here by hand.
{{PROVENANCE}}
PortSystem              1.0
PortGroup               cmake 1.1

name                    glifistore
version                 {{VERSION}}
revision                {{REVISION}}
categories              databases
license                 BSD
maintainers             {gmail.com:gpicchiarelli @gpicchiarelli}

description             Paired reader/writer key-value storage prototype

long_description        GlifiStore is an architectural prototype of a paired \
                        reader/writer key-value store: partition ownership, \
                        immutable read generations, bounded lanes and \
                        fail-closed recovery. It is engineering and research \
                        material, not production storage software.

homepage                https://github.com/gpicchiarelli/GlifiStore

master_sites            {{MASTER_SITES}}
distname                {{DISTNAME}}
use_xz                  yes

checksums               {{CHECKSUMS}}

depends_lib             port:openssl3

compiler.cxx_standard   2023

configure.args-append   -DGLIFISTORE_ENABLE_TLS=ON \
                        -DGLIFISTORE_BUILD_BENCHMARKS=OFF \
                        -DGLIFISTORE_BUILD_FUZZERS=OFF \
                        -DGLIFISTORE_FAULT_INJECTION=OFF \
                        -DGLIFISTORE_NATIVE_CPU=OFF \
                        -DGLIFISTORE_WARNINGS_AS_ERRORS=ON \
                        -DOPENSSL_ROOT_DIR=${prefix}

# A MacPorts build must resolve every dependency inside its own prefix. Picking
# up a Homebrew or /usr/local library is a packaging defect, so those search
# paths are refused at configure time instead of being noticed after install.
# The braces keep each ';'-separated CMake list inside one Tcl word.
configure.args-append   {-DCMAKE_IGNORE_PATH=/opt/homebrew;/opt/homebrew/bin;/opt/homebrew/lib;/usr/local;/usr/local/bin;/usr/local/lib} \
                        {-DCMAKE_IGNORE_PREFIX_PATH=/opt/homebrew;/usr/local}

test.run                yes
test.target             test

# Dedicated unprivileged service account; the daemon never runs as root.
add_users               glifistore group=glifistore \
                        realname=GlifiStore\ service\ account

# Unprivileged launchd job (MacPorts 2.7+ startupitem.user/group). The daemon is
# Type=simple / stays in the foreground, which matches startupitem.executable.
startupitem.create      yes
startupitem.executable  ${prefix}/bin/glifistored --config ${prefix}/etc/glifistore/glifistored.conf
startupitem.user        glifistore
startupitem.group       glifistore
startupitem.netchange   no

set glifistore_confdir ${prefix}/etc/glifistore
set glifistore_datadir ${prefix}/var/db/glifistore

destroot.keepdirs       ${destroot}${glifistore_datadir}

post-destroot {
    xinstall -d -m 0755 ${destroot}${glifistore_confdir}
    xinstall -m 0644 ${filespath}/glifistored.conf.sample \
        ${destroot}${glifistore_confdir}/glifistored.conf.sample
    reinplace "s|@GLIFISTORE_DATA_DIR@|${glifistore_datadir}|g" \
        ${destroot}${glifistore_confdir}/glifistored.conf.sample
    xinstall -d -m 0750 ${destroot}${glifistore_datadir}
}

post-activate {
    if {![file isdirectory ${glifistore_datadir}]} {
        xinstall -d -m 0750 ${glifistore_datadir}
    }
    file attributes ${glifistore_datadir} \
        -owner glifistore -group glifistore -permissions 0750
    if {![file exists ${glifistore_confdir}/glifistored.conf]} {
        xinstall -m 0644 ${glifistore_confdir}/glifistored.conf.sample \
            ${glifistore_confdir}/glifistored.conf
    }
}

notes "
GlifiStore is an architectural prototype. Review every limit in
${glifistore_confdir}/glifistored.conf before exposing the daemon beyond
loopback.

The port installs an unprivileged launchd startup item (user/group
glifistore). After install, start it with:

    sudo port load glifistore

Durable data lives in ${glifistore_datadir} and is never removed by
`port uninstall`.
"

livecheck.type          regex
livecheck.url           https://github.com/gpicchiarelli/GlifiStore/releases
livecheck.regex         {GlifiStore-(\d+(?:\.\d+)+)\.tar\.xz}
