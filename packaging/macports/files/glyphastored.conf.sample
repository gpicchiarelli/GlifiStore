# MacPorts-prefix example for glyphastored. The port installs this file as a
# sample; copy it to glyphastored.conf and review every limit before exposing
# the daemon beyond loopback. GlyphaStore is an architectural prototype.
#
# @GLYPHASTORE_DATA_DIR@ is replaced with ${prefix}/var/db/glyphastore by the
# Portfile at destroot time, so the path follows the MacPorts prefix in use.
profile=production
bind=127.0.0.1
port=7379
shard-pairs=1
storage-mode=durable-periodic
data-dir=@GLYPHASTORE_DATA_DIR@
open-mode=open-or-create
log-format=json
shutdown-drain-ms=30000
