@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

set(GLIFISTORE_BUILT_WITH_TLS "@GLIFISTORE_TLS_ENABLED@")
if(GLIFISTORE_BUILT_WITH_TLS)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    include(FindGlifiStoreTls)
    if(NOT GLIFISTORE_TLS_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "GlifiStore was built with TLS but OpenSSL/LibreSSL was not found. "
            "Set OPENSSL_ROOT_DIR or install OpenSSL 3.x.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GlifiStoreTargets.cmake")

set(GLIFISTORE_BUILT_WITH_LTO "@GLIFISTORE_LTO_ENABLED@")
if(GLIFISTORE_BUILT_WITH_LTO)
    set(_glifistore_lto_compiler_id "@CMAKE_CXX_COMPILER_ID@")
    set(_glifistore_lto_compiler_version "@CMAKE_CXX_COMPILER_VERSION@")
    if(NOT "${CMAKE_CXX_COMPILER_ID}" STREQUAL "${_glifistore_lto_compiler_id}" OR
       NOT "${CMAKE_CXX_COMPILER_VERSION}" VERSION_EQUAL "${_glifistore_lto_compiler_version}")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "GlifiStore was built with LTO using "
            "${_glifistore_lto_compiler_id} ${_glifistore_lto_compiler_version}; "
            "the consumer uses ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}.")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()

    include(CheckIPOSupported)
    check_ipo_supported(RESULT _glifistore_consumer_ipo_supported
                        OUTPUT _glifistore_consumer_ipo_error
                        LANGUAGES CXX)
    if(NOT _glifistore_consumer_ipo_supported)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "GlifiStore contains LTO archives but the consumer toolchain cannot link IPO: "
            "${_glifistore_consumer_ipo_error}")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()

    set(_glifistore_lto_link_options "@GLIFISTORE_LTO_LINK_OPTIONS@")
    foreach(_glifistore_target IN ITEMS core wire tls_layer client)
        set_property(TARGET GlifiStore::${_glifistore_target} APPEND PROPERTY
            INTERFACE_LINK_OPTIONS ${_glifistore_lto_link_options})
    endforeach()
    unset(_glifistore_target)
    unset(_glifistore_lto_link_options)
    unset(_glifistore_consumer_ipo_supported)
    unset(_glifistore_consumer_ipo_error)
    unset(_glifistore_lto_compiler_id)
    unset(_glifistore_lto_compiler_version)
endif()

check_required_components(GlifiStore)
