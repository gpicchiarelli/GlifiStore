{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glifistore.dev/schemas/release-context-v1.json",
  "title": "GlifiStore release context",
  "description": "Version-agnostic identity derived from VERSION, ABI_VERSION and git that drives packaging CI. Generated by engineering/tools/generate_release_context.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "product_version", "semver", "abi", "git", "package_revision", "release_kind", "previous", "package_versions", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "semver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "major", "minor", "patch", "prerelease", "build", "is_prerelease"],
      "properties": {
        "text": {"type": "string", "minLength": 5},
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0},
        "patch": {"type": "integer", "minimum": 0},
        "prerelease": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "build": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "is_prerelease": {"type": "boolean"}
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "version"],
      "properties": {
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag", "tag_is_annotated", "tag_matches_commit", "tree_clean"],
      "properties": {
        "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "tag": {"type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
        "tag_is_annotated": {"type": "boolean"},
        "tag_matches_commit": {"type": "boolean"},
        "tree_clean": {"type": "boolean"}
      }
    },
    "package_revision": {"type": "integer", "minimum": 0},
    "release_kind": {"enum": ["initial", "major", "minor", "patch", "prerelease"]},
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "version", "tag", "git_sha", "abi_major", "reason"],
      "properties": {
        "available": {"type": "boolean"},
        "version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "tag": {"type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "git_sha": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "abi_major": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "package_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deb", "freebsd", "homebrew", "macports", "openbsd", "rpm"],
      "properties": {
        "deb": {"$ref": "#/$defs/package_version"},
        "freebsd": {"$ref": "#/$defs/package_version"},
        "homebrew": {"$ref": "#/$defs/package_version"},
        "macports": {"$ref": "#/$defs/package_version"},
        "openbsd": {"$ref": "#/$defs/package_version"},
        "rpm": {"$ref": "#/$defs/package_version"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "package_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "upstream_version", "package_version", "fields", "limitations"],
      "properties": {
        "backend": {"enum": ["deb", "freebsd", "homebrew", "macports", "openbsd", "rpm"]},
        "upstream_version": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
