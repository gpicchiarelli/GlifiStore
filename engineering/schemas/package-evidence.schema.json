{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphastore.dev/schemas/package-evidence-v1.json",
  "title": "GlyphaStore package backend evidence",
  "description": "Per-backend, per-profile packaging evidence. A non-PASS result is a first-class outcome: NOT_RUN, BLOCKED and OPEN_GATE must be recorded honestly instead of being reported as PASS. Produced and validated by engineering/tools/validate_package_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "profile", "stage", "result", "lifecycle_state", "git_sha", "product_version", "package_version", "package_revision", "generated_at", "producer", "subject", "checks", "limitations", "residuals"],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"enum": ["deb", "freebsd", "homebrew", "macports", "openbsd", "rpm"]},
    "profile": {"enum": ["pr", "main", "nightly", "release"]},
    "stage": {"enum": ["metadata", "build", "inspect", "install", "verify", "upgrade", "remove", "full"]},
    "result": {"$ref": "#/$defs/status"},
    "lifecycle_state": {"enum": ["NONE", "STRUCTURAL", "BUILT", "INSTALLED", "FUNCTIONALLY_VERIFIED", "LIFECYCLE_VERIFIED", "UPGRADE_VERIFIED", "RELEASE_ADMITTED"]},
    "git_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "package_version": {"type": "string", "minLength": 1},
    "package_revision": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_id", "os", "os_version", "architecture"],
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256"],
      "properties": {
        "kind": {"enum": ["artifact", "source_tree"]},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "artifact"}}},
          "then": {"properties": {"sha256": {"type": "string"}}}
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "command", "evidence_ref", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "status": {"$ref": "#/$defs/status"},
          "command": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "detail": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "residuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "blocked_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
          "description": {"type": "string", "minLength": 1},
          "blocked_by": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE", "NOT_APPLICABLE_INITIAL_BASELINE", "BLOCKED", "OPEN_GATE"]
    }
  }
}
