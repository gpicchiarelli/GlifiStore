{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glifistore.dev/schemas/upgrade-baseline-v1.json",
  "title": "GlifiStore N-1 upgrade baseline",
  "description": "Auditable SemVer-aware selection of the previous sealed release that a package upgrade may be proven against. Generated by engineering/tools/upgrade_baseline.py. A tag is never admitted because it happens to be 'current minus one': every considered tag is recorded with the reason it was accepted or rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "product_version", "abi_major", "wire_version", "include_prereleases", "available", "upgrade_check_status", "reason", "selected", "rejected", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "abi_major": {"type": "integer", "minimum": 0},
    "wire_version": {"type": "integer", "minimum": 1},
    "include_prereleases": {"type": "boolean"},
    "available": {"type": "boolean"},
    "upgrade_check_status": {
      "description": "The only status the package-upgrade check may report before the upgrade actually runs: an initial baseline when nothing precedes this version, BLOCKED when something precedes it but no sealed release is admissible, NOT_RUN when a baseline is admissible and the upgrade has simply not been executed here.",
      "enum": ["NOT_APPLICABLE_INITIAL_BASELINE", "BLOCKED", "NOT_RUN"]
    },
    "reason": {"type": "string", "minLength": 1},
    "selected": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "tag", "git_sha", "abi_major", "assets"],
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
            "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
            "git_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "abi_major": {"type": "integer", "minimum": 0},
            "assets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest", "seal", "checksums", "provenance", "source_archive", "install_archive", "abi_consumer_archive", "wire_client_archive"],
              "properties": {
                "manifest": {"const": "release-manifest.json"},
                "seal": {"const": "verified-seal.json"},
                "checksums": {"const": "SHA256SUMS"},
                "provenance": {"type": ["string", "null"], "minLength": 1},
                "source_archive": {"type": "string", "minLength": 1},
                "install_archive": {"type": "string", "minLength": 1},
                "abi_consumer_archive": {"type": "string", "minLength": 1},
                "wire_client_archive": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "version", "reason", "detail"],
        "properties": {
          "tag": {"type": "string", "minLength": 1},
          "version": {"type": ["string", "null"], "minLength": 1},
          "reason": {
            "enum": [
              "not_semver",
              "not_older",
              "prerelease_excluded",
              "tag_not_annotated",
              "tag_version_mismatch",
              "tag_abi_invalid",
              "incompatible_abi",
              "no_published_release",
              "draft_release",
              "prerelease_published_as_stable",
              "stable_published_as_prerelease",
              "incomplete_assets",
              "superseded"
            ]
          },
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
