{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glifistore.dev/schemas/package-admission-v1.json",
  "title": "GlifiStore package release-admission report",
  "description": "Exact-artifact admission hook produced by engineering/tools/validate_package_admission.py. It binds package evidence and the artifact manifest to the sealed candidate source archive and to the N-1 upgrade baseline before any publish step may consider a package artifact. admitted is true only when nothing blocks: it is a report, never a gate promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "profile", "product_version", "package_revision", "git_sha", "candidate", "artifact_manifest", "evidence", "upgrade_baseline", "installed_sdk_matrix", "admitted", "blocking", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "profile": {"enum": ["pr", "main", "nightly", "release"]},
    "product_version": {"type": "string", "minLength": 5},
    "package_revision": {"type": "integer", "minimum": 0},
    "git_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seal_sha256", "source_name", "source_sha256"],
      "properties": {
        "seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_name": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent_source_name", "parent_source_sha256", "artifacts"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "parent_source_name": {"type": "string", "minLength": 1},
        "parent_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "sha256", "backend"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "backend": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "backend", "profile", "stage", "result", "lifecycle_state", "required_for_release", "subject_name", "subject_sha256", "upgrade_status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "backend": {"enum": ["deb", "freebsd", "homebrew", "macports", "openbsd", "rpm"]},
          "profile": {"enum": ["pr", "main", "nightly", "release"]},
          "stage": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1},
          "lifecycle_state": {"type": "string", "minLength": 1},
          "required_for_release": {"type": "boolean"},
          "subject_name": {"type": "string", "minLength": 1},
          "subject_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "upgrade_status": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "upgrade_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "upgrade_check_status", "tag"],
      "properties": {
        "available": {"type": "boolean"},
        "upgrade_check_status": {"enum": ["NOT_APPLICABLE_INITIAL_BASELINE", "BLOCKED", "NOT_RUN"]},
        "tag": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "installed_sdk_matrix": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "package_installed", "reason"],
          "properties": {
            "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
            "package_installed": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "admitted": {"type": "boolean"},
    "blocking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "detail"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"admitted": {"const": true}}, "required": ["admitted"]},
      "then": {"properties": {"blocking": {"maxItems": 0}}}
    }
  ]
}
